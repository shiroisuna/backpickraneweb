DATABASE_URL="mysql://root:@localhost:3306/pickcrane"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
PORT=4000

# Datos de pago móvil de LA APP (a donde el cliente transfiere), no de un gruero ni un cliente
PAGO_MOVIL_BANCO="Banco de Ejemplo"
PAGO_MOVIL_TELEFONO="0412-0000000"
PAGO_MOVIL_CEDULA="J-00000000-0"
ADMIN_EMAIL="admin@pickcrane.com"
ADMIN_PASSWORD="admin123456"

# URL del FRONTEND (no del backend) — se usa para armar los enlaces de
# verificación de correo y de recuperación de contraseña dentro de los
# emails. En producción, pon la URL pública real (https://tudominio.com).
FRONTEND_URL="http://localhost:5173"

# Correo (opcional): si dejas SMTP_HOST vacío, los correos NO se envían de
# verdad — el backend solo los imprime en su propia consola (útil para
# seguir probando sin necesidad de configurar un correo real todavía).
# Para pruebas reales gratis, puedes usar Mailtrap.io (https://mailtrap.io)
# o un Gmail con "contraseña de aplicación".
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PickCrane <no-reply@pickcrane.com>"
